    "SaveSettingsRequest": {
      "additionalProperties": false,
      "description": "Store these settings in place of the stored ones, and use them at once.\nRefused (`stale_settings`) if the stored ones are no longer `revision`,\nthe one the edit was made on.",
      "properties": {
        "command": {
          "const": "save_settings",
          "default": "save_settings",
          "title": "Command",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/Settings"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "settings",
        "revision"
      ],
      "title": "SaveSettingsRequest",
      "type": "object"
    },
    "SaveSettingsResult": {
      "description": "Saved and in use: every monitor shows what they say.",
      "properties": {
        "command": {
          "const": "save_settings",
          "default": "save_settings",
          "title": "Command",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "warnings": {
          "default": [],
