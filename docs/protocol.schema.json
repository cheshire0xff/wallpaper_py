{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wallpaper_py socket protocol",
  "description": "Protocol version 3. One JSON object per line: a Request in; a Reply out, or Events while subscribed. See docs/protocol.md.",
  "anyOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Reply"
    },
    {
      "$ref": "#/$defs/Event"
    }
  ],
  "$defs": {
    "Background": {
      "description": "A background worked out from the image (core.imaging): its average\ncolour, its most common colour, the colour of its edges next to the\nbars, or a blurred copy of the image itself.",
      "enum": [
        "average",
        "dominant",
        "edges",
        "blur"
      ],
      "title": "Background",
      "type": "string"
    },
    "Change": {
      "properties": {
        "playlist": {
          "title": "Playlist",
          "type": "string"
        },
        "image": {
          "format": "path",
          "title": "Image",
          "type": "string"
        },
        "reason": {
          "enum": [
            "scheduled",
            "next",
            "previous",
            "picked",
            "restored"
          ],
          "title": "Reason",
          "type": "string"
        },
        "shown_on": {
          "items": {
            "type": "string"
          },
          "title": "Shown On",
          "type": "array"
        },
        "missed": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missed",
          "type": "array"
        }
      },
      "required": [
        "playlist",
        "image",
        "reason",
        "shown_on"
      ],
      "title": "Change",
      "type": "object"
    },
    "ChangedEvent": {
      "description": "A wallpaper changed, by a tick or by a command.",
      "properties": {
        "event": {
          "const": "changed",
          "default": "changed",
          "title": "Event",
          "type": "string"
        },
        "change": {
          "$ref": "#/$defs/Change"
        }
      },
      "required": [
        "change"
      ],
      "title": "ChangedEvent",
      "type": "object"
    },
    "DesktopMonitor": {
      "description": "A monitor the desktop lists, whether a playlist drives it or not.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Geometry"
            },
            {
              "type": "null"
            }
          ]
        },
        "look": {
          "$ref": "#/$defs/Look",
          "default": {
            "mode": "fill",
            "background": "#000000",
            "blur": 0.005,
            "darken": 0.25
          }
        }
      },
      "required": [
        "id",
        "name",
        "geometry"
      ],
      "title": "DesktopMonitor",
      "type": "object"
    },
    "Envelope": {
      "additionalProperties": false,
      "description": "A request on the wire.",
      "properties": {
        "v": {
          "default": 3,
          "title": "V",
          "type": "integer"
        },
        "request": {
          "discriminator": {
            "mapping": {
              "fav": "#/$defs/Request",
              "hold": "#/$defs/Request",
              "next": "#/$defs/Request",
              "pick": "#/$defs/PickRequest",
              "prev": "#/$defs/Request",
              "remove": "#/$defs/Request",
              "reset_cycle": "#/$defs/ResetCycleRequest",
              "resume": "#/$defs/Request",
              "save_settings": "#/$defs/SaveSettingsRequest",
              "settings": "#/$defs/SettingsRequest",
              "stats": "#/$defs/StatsRequest",
              "status": "#/$defs/Request",
              "subscribe": "#/$defs/Subscribe",
              "unfav": "#/$defs/Request"
            },
            "propertyName": "command"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Request"
            },
            {
              "$ref": "#/$defs/PickRequest"
            },
            {
              "$ref": "#/$defs/StatsRequest"
            },
            {
              "$ref": "#/$defs/ResetCycleRequest"
            },
            {
              "$ref": "#/$defs/SettingsRequest"
            },
            {
              "$ref": "#/$defs/SaveSettingsRequest"
            },
            {
              "$ref": "#/$defs/Subscribe"
            }
          ],
          "title": "Request"
        }
      },
      "required": [
        "request"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "ErrorInfo": {
      "properties": {
        "kind": {
          "enum": [
            "protocol",
            "config_error",
            "unknown_target",
            "not_attached",
            "no_images",
            "nothing_shown",
            "bad_image",
            "invalid_settings",
            "stale_settings",
            "failed",
            "internal",
            "unreachable"
          ],
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "ErrorReply": {
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorInfo"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorReply",
      "type": "object"
    },
    "Event": {
      "oneOf": [
        {
          "$ref": "#/$defs/ChangedEvent"
        },
        {
          "$ref": "#/$defs/OverviewChangedEvent"
        }
      ],
      "discriminator": {
        "propertyName": "event",
        "mapping": {
          "changed": "#/$defs/ChangedEvent",
          "overview_changed": "#/$defs/OverviewChangedEvent"
        }
      }
    },
    "Geometry": {
      "description": "A monitor's area in desktop coordinates (x and y may be negative), and\nits size in pixels if that differs (Wayland's logical coordinates:\ncore.model.Rectangle).",
      "properties": {
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "pixels": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pixels"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Geometry",
      "type": "object"
    },
    "HoldResult": {
      "properties": {
        "command": {
          "const": "hold",
          "default": "hold",
          "title": "Command",
          "type": "string"
        },
        "playlist": {
          "title": "Playlist",
          "type": "string"
        },
        "held": {
          "title": "Held",
          "type": "boolean"
        },
        "changed": {
          "title": "Changed",
          "type": "boolean"
        }
      },
      "required": [
        "playlist",
        "held",
        "changed"
      ],
      "title": "HoldResult",
      "type": "object"
    },
    "ImageMode": {
      "enum": [
        "fill",
        "fit",
        "stretch"
      ],
      "title": "ImageMode",
      "type": "string"
    },
    "ListStats": {
      "description": "A list file's entries (lines naming a path), and how many exist.",
      "properties": {
        "file": {
          "format": "path",
          "title": "File",
          "type": "string"
        },
        "listed": {
          "title": "Listed",
          "type": "integer"
        },
        "available": {
          "title": "Available",
          "type": "integer"
        }
      },
      "required": [
        "file",
        "listed",
        "available"
      ],
      "title": "ListStats",
      "type": "object"
    },
    "Look": {
      "additionalProperties": false,
      "description": "How an image looks on one screen: everything the renderer needs besides\nthe image and the sizes (core.imaging.render). Per monitor; more fields\n(later a crop anchor) join here.\n\n`background` fills the bars of Fit, and is kept (unused) in the other\nmodes, so going back to Fit brings it back; so are `blur` and `darken`\n(the `blur` background's) with any other background.\n\nA pydantic dataclass: stored with the monitor's settings (as JSON, so a\nnew field with a default loads from rows stored before it) and sent on\nthe socket (the overview, the settings), read strictly.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/ImageMode",
          "default": "fill"
        },
        "background": {
          "anyOf": [
            {
              "$ref": "#/$defs/Background"
            },
            {
              "pattern": "^#[0-9a-f]{6}$",
              "type": "string"
            }
          ],
          "default": "#000000",
          "title": "Background"
        },
        "blur": {
          "default": 0.005,
          "title": "Blur",
          "type": "number"
        },
        "darken": {
          "default": 0.25,
          "title": "Darken",
          "type": "number"
        }
      },
      "title": "Look",
      "type": "object"
    },
    "MarkResult": {
      "properties": {
        "command": {
          "enum": [
            "fav",
            "unfav"
          ],
          "title": "Command",
          "type": "string"
        },
        "playlist": {
          "title": "Playlist",
          "type": "string"
        },
        "image": {
          "format": "path",
          "title": "Image",
          "type": "string"
        },
        "list_file": {
          "format": "path",
          "title": "List File",
          "type": "string"
        },
        "changed": {
          "title": "Changed",
          "type": "boolean"
        }
      },
      "required": [
        "command",
        "playlist",
        "image",
        "list_file",
        "changed"
      ],
      "title": "MarkResult",
      "type": "object"
    },
    "MonitorSettings": {
      "additionalProperties": false,
      "description": "One monitor's settings, by id: its playlist (None: none) and its look.\nA monitor without a row has no playlist and the default look.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "playlist": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Playlist"
        },
        "look": {
          "$ref": "#/$defs/Look",
          "default": {
            "mode": "fill",
            "background": "#000000",
            "blur": 0.005,
            "darken": 0.25
          }
        }
      },
      "required": [
        "id"
      ],
      "title": "MonitorSettings",
      "type": "object"
    },
    "MonitorView": {
      "description": "A playlist's member. `id` is spelt as the desktop spells it when the\nmonitor is listed (as in `Overview.monitors`), else as the settings\ndo; ids compare case-insensitively (`MonitorId`).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "attached": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attached"
        },
        "look": {
          "$ref": "#/$defs/Look",
          "default": {
            "mode": "fill",
            "background": "#000000",
            "blur": 0.005,
            "darken": 0.25
          }
        }
      },
      "required": [
        "id",
        "name",
        "attached"
      ],
      "title": "MonitorView",
      "type": "object"
    },
    "NextResult": {
      "properties": {
        "command": {
          "const": "next",
          "default": "next",
          "title": "Command",
          "type": "string"
        },
        "playlist": {
          "title": "Playlist",
          "type": "string"
        },
        "change": {
          "$ref": "#/$defs/Change"
        }
      },
      "required": [
        "playlist",
        "change"
      ],
      "title": "NextResult",
      "type": "object"
    },
    "Order": {
      "enum": [
        "sorted",
        "shuffle"
      ],
      "title": "Order",
      "type": "string"
    },
    "Overview": {
      "description": "The small snapshot the tray and the windows draw from.",
      "properties": {
        "playlists": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlaylistView"
          },
          "title": "Playlists",
          "type": "array"
        },
        "monitors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DesktopMonitor"
          },
          "title": "Monitors",
          "type": "array"
        },
        "paused": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paused"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "title": "Overview",
      "type": "object"
    },
    "OverviewChangedEvent": {
      "description": "The overview changed; also the first event of every subscription.",
      "properties": {
        "event": {
          "const": "overview_changed",
          "default": "overview_changed",
          "title": "Event",
          "type": "string"
        },
        "overview": {
          "$ref": "#/$defs/Overview"
        }
      },
      "required": [
        "overview"
      ],
      "title": "OverviewChangedEvent",
      "type": "object"
    },
    "PickRequest": {
      "additionalProperties": false,
      "description": "Show a chosen image on a playlist now (from any directory).",
      "properties": {
        "command": {
          "const": "pick",
          "default": "pick",
          "title": "Command",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "image": {
          "format": "path",
          "title": "Image",
          "type": "string"
        }
      },
      "required": [
        "image"
      ],
      "title": "PickRequest",
      "type": "object"
    },
    "PickResult": {
      "properties": {
        "command": {
          "const": "pick",
          "default": "pick",
          "title": "Command",
          "type": "string"
        },
        "playlist": {
          "title": "Playlist",
          "type": "string"
        },
        "change": {
          "$ref": "#/$defs/Change"
        }
      },
      "required": [
        "playlist",
        "change"
      ],
      "title": "PickResult",
      "type": "object"
    },
    "PlaylistDetails": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "monitors": {
          "items": {
            "$ref": "#/$defs/MonitorView"
          },
          "title": "Monitors",
          "type": "array"
        },
        "current": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current"
        },
        "favourite": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Favourite"
        },
        "held": {
          "default": false,
          "title": "Held",
          "type": "boolean"
        },
        "manual": {
          "default": false,
          "title": "Manual",
          "type": "boolean"
        },
        "directory": {
          "format": "path",
          "title": "Directory",
          "type": "string"
        },
        "order": {
          "$ref": "#/$defs/Order"
        },
        "interval": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Interval"
        },
        "next_in_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next In Seconds"
        },
        "upcoming": {
          "items": {
            "format": "path",
            "type": "string"
          },
          "title": "Upcoming",
          "type": "array"
        }
      },
      "required": [
        "name",
        "monitors",
        "current",
        "favourite",
        "directory",
        "order",
        "interval",
        "next_in_seconds",
        "upcoming"
      ],
      "title": "PlaylistDetails",
      "type": "object"
    },
    "PlaylistSettings": {
      "additionalProperties": false,
      "description": "A folder rotated on the monitors that name this playlist (the same\nimage on each: mirrored).\n\n`id` is generated (`new_playlist_id`) and never reused: deleting a\nplaylist deletes its state, and a new one starts afresh. `interval` is\nNone for a manual playlist: it never changes by itself, only by next /\nprev / pick.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "directory": {
          "format": "path",
          "title": "Directory",
          "type": "string"
        },
        "order": {
          "$ref": "#/$defs/Order",
          "default": "shuffle"
        },
        "interval": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 1800.0,
          "title": "Interval"
        }
      },
      "required": [
        "id",
        "name",
        "directory"
      ],
      "title": "PlaylistSettings",
      "type": "object"
    },
    "PlaylistStats": {
      "description": "What a playlist picks up from its folder. images = seen + unseen +\nskipped. A sorted playlist's seen / unseen: up to and including the\nwalk's image / after it, in name order.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "directory": {
          "format": "path",
          "title": "Directory",
          "type": "string"
        },
        "order": {
          "$ref": "#/$defs/Order"
        },
        "scan_age": {
          "title": "Scan Age",
          "type": "number"
        },
        "images": {
          "title": "Images",
          "type": "integer"
        },
        "seen": {
          "title": "Seen",
          "type": "integer"
        },
        "unseen": {
          "title": "Unseen",
          "type": "integer"
        },
        "skipped": {
          "title": "Skipped",
          "type": "integer"
        },
        "favourites_here": {
          "title": "Favourites Here",
          "type": "integer"
        },
        "to_remove_here": {
          "title": "To Remove Here",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "directory",
        "order",
        "scan_age",
        "images",
        "seen",
        "unseen",
        "skipped",
        "favourites_here",
        "to_remove_here"
      ],
      "title": "PlaylistStats",
      "type": "object"
    },
    "PlaylistView": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "monitors": {
          "items": {
            "$ref": "#/$defs/MonitorView"
          },
          "title": "Monitors",
          "type": "array"
        },
        "current": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current"
        },
        "favourite": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Favourite"
        },
        "held": {
          "default": false,
          "title": "Held",
          "type": "boolean"
        },
        "manual": {
          "default": false,
          "title": "Manual",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "monitors",
        "current",
        "favourite"
      ],
      "title": "PlaylistView",
      "type": "object"
    },
    "PrevResult": {
      "properties": {
        "command": {
          "const": "prev",
          "default": "prev",
          "title": "Command",
          "type": "string"
        },
        "playlist": {
          "title": "Playlist",
          "type": "string"
        },
        "change": {
          "anyOf": [
            {
              "$ref": "#/$defs/Change"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "playlist",
        "change"
      ],
      "title": "PrevResult",
      "type": "object"
    },
    "RemoveResult": {
      "properties": {
        "command": {
          "const": "remove",
          "default": "remove",
          "title": "Command",
          "type": "string"
        },
        "playlist": {
          "title": "Playlist",
          "type": "string"
        },
        "image": {
          "format": "path",
          "title": "Image",
          "type": "string"
        },
        "list_file": {
          "format": "path",
          "title": "List File",
          "type": "string"
        },
        "change": {
          "anyOf": [
            {
              "$ref": "#/$defs/Change"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "playlist",
        "image",
        "list_file",
        "change"
      ],
      "title": "RemoveResult",
      "type": "object"
    },
    "Reply": {
      "anyOf": [
        {
          "oneOf": [
            {
              "$ref": "#/$defs/StatusResult"
            },
            {
              "$ref": "#/$defs/NextResult"
            },
            {
              "$ref": "#/$defs/PrevResult"
            },
            {
              "$ref": "#/$defs/MarkResult"
            },
            {
              "$ref": "#/$defs/RemoveResult"
            },
            {
              "$ref": "#/$defs/PickResult"
            },
            {
              "$ref": "#/$defs/HoldResult"
            },
            {
              "$ref": "#/$defs/ResumeResult"
            },
            {
              "$ref": "#/$defs/StatsResult"
            },
            {
              "$ref": "#/$defs/ResetCycleResult"
            },
            {
              "$ref": "#/$defs/SettingsResult"
            },
            {
              "$ref": "#/$defs/SaveSettingsResult"
            }
          ],
          "discriminator": {
            "propertyName": "command",
            "mapping": {
              "status": "#/$defs/StatusResult",
              "next": "#/$defs/NextResult",
              "prev": "#/$defs/PrevResult",
              "fav": "#/$defs/MarkResult",
              "unfav": "#/$defs/MarkResult",
              "remove": "#/$defs/RemoveResult",
              "pick": "#/$defs/PickResult",
              "hold": "#/$defs/HoldResult",
              "resume": "#/$defs/ResumeResult",
              "stats": "#/$defs/StatsResult",
              "reset_cycle": "#/$defs/ResetCycleResult",
              "settings": "#/$defs/SettingsResult",
              "save_settings": "#/$defs/SaveSettingsResult"
            }
          }
        },
        {
          "$ref": "#/$defs/ErrorReply"
        }
      ]
    },
